<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../common-library.props" />

  <PropertyGroup>
    <Description>DiscUtils SquashFS 2.x filesystem parser</Description>
    <Authors>Kenneth Bell;LordMike</Authors>
    <PackageTags>DiscUtils;Filesystem;SquashFS</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiscUtils.Core\DiscUtils.Core.csproj" />
  </ItemGroup>

  <!-- Managed LZMA for non-zlib data blocks (vendor variants): only the
       modern target carries it; older targets keep zlib-only support. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="SharpCompress" Version="1.0.0" />
  </ItemGroup>

</Project>
